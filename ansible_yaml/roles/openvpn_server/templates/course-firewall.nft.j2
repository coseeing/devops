table inet openvpn_course_input {
  chain input {
    type filter hook input priority filter; policy accept;
    iifname "tun-course" ip saddr {{ openvpn_vpn_cidr }} tcp dport {{ openvpn_nvda_remote_port }} accept
    iifname "tun-course" drop
    iifname "lo" tcp dport {{ openvpn_nvda_remote_port }} accept
    ip saddr {{ openvpn_windows_cidr }} tcp dport {{ openvpn_nvda_remote_port }} accept
    tcp dport {{ openvpn_nvda_remote_port }} drop
  }
}

table ip openvpn_course_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr {{ openvpn_vpn_cidr }} ip daddr {{ openvpn_windows_cidr }} tcp dport 3389 masquerade
  }
}
