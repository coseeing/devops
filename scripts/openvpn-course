#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly PRODUCTION_ENV_FILE=/etc/openvpn/openvpn-course.env
ENV_FILE=${OPENVPN_COURSE_ENV_FILE:-$PRODUCTION_ENV_FILE}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

load_environment() {
  [[ -f "$ENV_FILE" ]] || die "configuration not found: $ENV_FILE"
  if [[ "$ENV_FILE" == "$PRODUCTION_ENV_FILE" ]]; then
    [[ $EUID -eq 0 ]] || die "run with sudo"
    [[ $(stat -c '%u' "$ENV_FILE") == 0 ]] || die "configuration must be root-owned"
    local mode
    mode=$(stat -c '%a' "$ENV_FILE")
    (( (8#$mode & 8#077) == 0 )) || die "configuration must not be accessible by group or other"
  fi

  # The Ansible template shell-quotes every value and defines only the allowlisted names.
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  local name
  for name in PROFILE_PATH PKI_DIR ACTIVE_CLIENT_CN_FILE STATUS_PATH ENDPOINT VPN_CIDR WINDOWS_CIDR PROFILE_BUCKET AWS_REGION; do
    [[ -n ${!name:-} ]] || die "missing configuration: $name"
  done
}

status_command() {
  local clients=0 service_state listener expiry active_cn
  active_cn=$(<"$ACTIVE_CLIENT_CN_FILE")
  service_state=$(systemctl is-active openvpn-server@course 2>/dev/null || true)
  listener=$(ss -lun 2>/dev/null | grep -Ec '[:.]1194[[:space:]]' || true)
  [[ -f "$STATUS_PATH" ]] && clients=$(grep -c '^CLIENT_LIST,' "$STATUS_PATH" || true)
  expiry=$(openssl x509 -in "$PKI_DIR/pki/issued/$active_cn.crt" -enddate -noout 2>/dev/null || true)
  printf 'Service: %s\nUDP 1194 listeners: %s\nEndpoint: %s\nVPN CIDR: %s\nWindows CIDR: %s\nConnected clients: %s\nCertificate: %s\n' \
    "${service_state:-unknown}" "$listener" "$ENDPOINT" "$VPN_CIDR" "$WINDOWS_CIDR" "$clients" "${expiry:-unknown}"
}

publish_export() {
  local profile_path=$1 destination_directory=$2 destination_name=$3 force=$4 owner_uid=$5 owner_gid=$6
  python3 - "$profile_path" "$destination_directory" "$destination_name" "$force" "$owner_uid" "$owner_gid" <<'PY'
import errno
import os
import secrets
import stat
import sys

profile_path, directory, destination_name, force, owner_uid, owner_gid = sys.argv[1:]


class ExportError(Exception):
    pass


def close_fd(fd):
    if fd >= 0:
        os.close(fd)


def sync_directory(directory_fd):
    try:
        os.fsync(directory_fd)
    except OSError as error:
        if error.errno not in (errno.EINVAL, errno.EROFS):
            raise


def copy_file(source_fd, staging_fd):
    while True:
        chunk = os.read(source_fd, 1024 * 1024)
        if not chunk:
            return
        view = memoryview(chunk)
        while view:
            written = os.write(staging_fd, view)
            view = view[written:]


def create_staging_file(directory_fd):
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    for _ in range(32):
        name = ".openvpn-course." + secrets.token_hex(16)
        try:
            return name, os.open(name, flags, 0o600, dir_fd=directory_fd)
        except FileExistsError:
            continue
    raise ExportError("could not create export temporary file")


def open_directory_component(parent_fd, component, directory_flags):
    try:
        component_stat = os.stat(component, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError as error:
        raise ExportError("destination directory does not exist") from error
    if stat.S_ISLNK(component_stat.st_mode):
        raise ExportError("destination directory must not contain symlinks")
    if not stat.S_ISDIR(component_stat.st_mode):
        raise ExportError("destination directory component is not a directory")
    return os.open(component, directory_flags, dir_fd=parent_fd)


def open_destination_directory(directory):
    directory_flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    if os.path.isabs(directory):
        directory_fd = os.open(os.sep, directory_flags)
    else:
        directory_fd = os.open(".", directory_flags)

    try:
        for component in directory.split(os.sep):
            if component in ("", "."):
                continue
            if component == "..":
                raise ExportError("destination directory must not contain '..'")
            next_fd = open_directory_component(directory_fd, component, directory_flags)
            close_fd(directory_fd)
            directory_fd = next_fd
    except Exception:
        close_fd(directory_fd)
        raise
    return directory_fd


def publish(directory_fd, staging_name, destination_name, force):
    try:
        destination_stat = os.stat(destination_name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        destination_stat = None

    if destination_stat is None:
        try:
            os.link(
                staging_name,
                destination_name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except FileExistsError as error:
            raise ExportError("destination already exists") from error
        os.unlink(staging_name, dir_fd=directory_fd)
        return

    if force != "--force":
        raise ExportError("destination already exists")
    if not stat.S_ISREG(destination_stat.st_mode):
        raise ExportError("destination must be a regular file")
    os.replace(
        staging_name,
        destination_name,
        src_dir_fd=directory_fd,
        dst_dir_fd=directory_fd,
    )


def main():
    source_fd = directory_fd = staging_fd = -1
    staging_name = None
    staging_identity = None
    try:
        source_fd = os.open(profile_path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        if not stat.S_ISREG(os.fstat(source_fd).st_mode):
            raise ExportError("profile must be a regular file")

        if destination_name in (".", ".."):
            raise ExportError("destination must name a regular file")
        directory_fd = open_destination_directory(directory)
        staging_name, staging_fd = create_staging_file(directory_fd)
        staging_stat = os.fstat(staging_fd)
        if not stat.S_ISREG(staging_stat.st_mode):
            raise ExportError("temporary export is not a regular file")
        staging_identity = (staging_stat.st_dev, staging_stat.st_ino)

        copy_file(source_fd, staging_fd)
        os.fchmod(staging_fd, 0o600)
        if owner_uid and owner_gid:
            os.fchown(staging_fd, int(owner_uid), int(owner_gid))
        os.fsync(staging_fd)
        publish(directory_fd, staging_name, destination_name, force)
        staging_name = None
        sync_directory(directory_fd)
    except (ExportError, OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        if directory_fd >= 0 and staging_name is not None and staging_identity is not None:
            try:
                current = os.stat(staging_name, dir_fd=directory_fd, follow_symlinks=False)
                if stat.S_ISREG(current.st_mode) and (current.st_dev, current.st_ino) == staging_identity:
                    os.unlink(staging_name, dir_fd=directory_fd)
            except OSError:
                pass
        close_fd(staging_fd)
        close_fd(source_fd)
        close_fd(directory_fd)
    return 0


raise SystemExit(main())
PY
}

export_command() {
  local destination force= destination_directory destination_name owner_uid= owner_gid=

  [[ $# -ge 1 && $# -le 2 ]] || die "usage: openvpn-course export DEST [--force]"
  destination=$1
  [[ -n "$destination" ]] || die "usage: openvpn-course export DEST [--force]"
  [[ "$destination" != --force ]] || die "usage: openvpn-course export DEST [--force]"
  if [[ $# -eq 2 ]]; then
    force=$2
    [[ "$force" == --force ]] || die "usage: openvpn-course export DEST [--force]"
  fi

  case "$destination" in
    */*)
      destination_directory=${destination%/*}
      [[ -n "$destination_directory" ]] || destination_directory=/
      destination_name=${destination##*/}
      ;;
    *)
      destination_directory=.
      destination_name=$destination
      ;;
  esac
  [[ -n "$destination_name" ]] || die "destination must name a regular file: $destination"
  if [[ ${SUDO_UID:-} =~ ^[0-9]+$ && ${SUDO_GID:-} =~ ^[0-9]+$ ]]; then
    owner_uid=$SUDO_UID
    owner_gid=$SUDO_GID
  fi
  publish_export "$PROFILE_PATH" "$destination_directory" "$destination_name" "$force" "$owner_uid" "$owner_gid" || die "could not publish export: $destination"
  printf 'Exported %s\n' "$destination"
}

logs_command() {
  journalctl -u openvpn-server@course --no-pager -n 100
}

load_environment
case ${1:-} in
  status)
    [[ $# -eq 1 ]] || die "usage: openvpn-course status"
    status_command
    ;;
  export)
    shift
    export_command "$@"
    ;;
  logs)
    [[ $# -eq 1 ]] || die "usage: openvpn-course logs"
    logs_command
    ;;
  *) die "usage: openvpn-course {status|export|logs}" ;;
esac
