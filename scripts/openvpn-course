#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly PRODUCTION_ENV_FILE=/etc/openvpn/openvpn-course.env
ENV_FILE=${OPENVPN_COURSE_ENV_FILE:-$PRODUCTION_ENV_FILE}
ROTATION_WORK=
ROTATION_BACKUP=
ROTATION_RELOAD_ON_ROLLBACK=0

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

load_environment() {
  [[ -f "$ENV_FILE" ]] || die "configuration not found: $ENV_FILE"
  if [[ "$ENV_FILE" == "$PRODUCTION_ENV_FILE" ]]; then
    [[ $EUID -eq 0 ]] || die "run with sudo"
    [[ $(stat -c '%u' "$ENV_FILE") == 0 ]] || die "configuration must be root-owned"
    local mode
    mode=$(stat -c '%a' "$ENV_FILE")
    (( (8#$mode & 8#077) == 0 )) || die "configuration must not be accessible by group or other"
  fi

  # The Ansible template shell-quotes every value and defines only the allowlisted names.
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  local name
  for name in PROFILE_PATH PKI_DIR ACTIVE_CLIENT_CN_FILE SERVER_CRL_PATH LAST_SHARED_KEY_FILE STATUS_PATH ENDPOINT VPN_CIDR WINDOWS_CIDR PROFILE_BUCKET AWS_REGION MUTATION_LOCK_PATH; do
    [[ -n ${!name:-} ]] || die "missing configuration: $name"
  done
  MUTATION_LOCK_PATH=${OPENVPN_COURSE_LOCK_PATH:-$MUTATION_LOCK_PATH}
  [[ "$MUTATION_LOCK_PATH" == /* ]] || die "mutation lock path must be absolute"
}

acquire_mutation_lock() {
  command -v flock >/dev/null 2>&1 || die "flock is required for mutating operations"
  exec 9>"$MUTATION_LOCK_PATH" || die "could not open mutation lock: $MUTATION_LOCK_PATH"
  flock -n 9 || die "another rotate or share operation is already in progress"
}

status_command() {
  local clients=0 service_state listener expiry active_cn
  active_cn=$(<"$ACTIVE_CLIENT_CN_FILE")
  service_state=$(systemctl is-active openvpn-server@course 2>/dev/null || true)
  listener=$(ss -lun 2>/dev/null | grep -Ec '[:.]1194[[:space:]]' || true)
  [[ -f "$STATUS_PATH" ]] && clients=$(grep -c '^CLIENT_LIST,' "$STATUS_PATH" || true)
  expiry=$(openssl x509 -in "$PKI_DIR/pki/issued/$active_cn.crt" -enddate -noout 2>/dev/null || true)
  printf 'Service: %s\nUDP 1194 listeners: %s\nEndpoint: %s\nVPN CIDR: %s\nWindows CIDR: %s\nConnected clients: %s\nCertificate: %s\n' \
    "${service_state:-unknown}" "$listener" "$ENDPOINT" "$VPN_CIDR" "$WINDOWS_CIDR" "$clients" "${expiry:-unknown}"
}

atomic_staging_path() {
  local target=$1 target_directory target_name
  case "$target" in
    */*)
      target_directory=${target%/*}
      [[ -n "$target_directory" ]] || target_directory=/
      target_name=${target##*/}
      ;;
    *)
      target_directory=.
      target_name=$target
      ;;
  esac
  [[ -n "$target_name" && "$target_name" != "." && "$target_name" != ".." ]] || return 1
  [[ -d "$target_directory" ]] || return 1
  mktemp "$target_directory/.${target_name}.XXXXXX"
}

publish_copy_atomically() {
  local source=$1 target=$2 staging=
  staging=$(atomic_staging_path "$target") || return 1
  if ! cp -p "$source" "$staging"; then
    rm -f "$staging"
    return 1
  fi
  if ! mv -f "$staging" "$target"; then
    rm -f "$staging"
    return 1
  fi
}

publish_file_atomically() {
  local source=$1 target=$2 mode=$3 staging=
  staging=$(atomic_staging_path "$target") || return 1
  if ! install -m "$mode" "$source" "$staging"; then
    rm -f "$staging"
    return 1
  fi
  if ! mv -f "$staging" "$target"; then
    rm -f "$staging"
    return 1
  fi
}

publish_text_atomically() {
  local value=$1 target=$2 mode=$3 staging=
  staging=$(atomic_staging_path "$target") || return 1
  if ! printf '%s\n' "$value" >"$staging"; then
    rm -f "$staging"
    return 1
  fi
  if ! chmod "$mode" "$staging"; then
    rm -f "$staging"
    return 1
  fi
  if ! mv -f "$staging" "$target"; then
    rm -f "$staging"
    return 1
  fi
}

safe_remove_rotation_directory() {
  local path=${1:-}
  case "$path" in
    "$PKI_DIR"/rotate.*|"$PKI_DIR"/rollback.*)
      rm -rf "$path"
      ;;
    "")
      ;;
    *)
      printf 'warning: refusing to remove unexpected temporary path: %s\n' "$path" >&2
      ;;
  esac
}

cleanup_rotation() {
  safe_remove_rotation_directory "${ROTATION_WORK:-}"
  safe_remove_rotation_directory "${ROTATION_BACKUP:-}"
  ROTATION_WORK=
  ROTATION_BACKUP=
}

validate_rendered_profile() {
  local profile=$1 block
  for block in '<ca>' '<cert>' '<key>' '<tls-crypt>'; do
    if ! grep -Fq "$block" "$profile"; then
      printf 'error: rendered profile is missing %s\n' "$block" >&2
      return 1
    fi
  done
}

utc_after_seconds() {
  local seconds=$1
  date -u -d "+$seconds seconds" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || \
    date -u -v+"${seconds}"S '+%Y-%m-%dT%H:%M:%SZ'
}

backup_pki_file() {
  local name=$1 source=$PKI_DIR/pki/$name target=$ROTATION_BACKUP/pki-files/$name
  if [[ -e "$source" || -L "$source" ]]; then
    cp -p "$source" "$target"
  fi
}

backup_pki_directory() {
  local name=$1 source=$PKI_DIR/pki/$name target=$ROTATION_BACKUP/pki-dirs/$name
  if [[ -e "$source" || -L "$source" ]]; then
    [[ -d "$source" && ! -L "$source" ]] || die "PKI $name path must be a directory"
    mkdir -p "$target" "$ROTATION_BACKUP/pki-dir-markers"
    cp -pR "$source/." "$target/"
    : >"$ROTATION_BACKUP/pki-dir-markers/$name"
  fi
}

backup_rotation_state() {
  local name
  mkdir -p "$ROTATION_BACKUP/pki-files" "$ROTATION_BACKUP/pki-dirs"
  for name in \
    index.txt index.txt.attr index.txt.attr.old index.txt.old \
    serial serial.old crlnumber crlnumber.old crl.pem; do
    backup_pki_file "$name"
  done
  for name in issued private reqs certs_by_serial revoked renewed inline; do
    backup_pki_directory "$name"
  done
  cp -p "$PROFILE_PATH" "$ROTATION_BACKUP/profile.ovpn"
  cp -p "$ACTIVE_CLIENT_CN_FILE" "$ROTATION_BACKUP/active-client-cn"
  cp -p "$SERVER_CRL_PATH" "$ROTATION_BACKUP/server-crl.pem"
}

restore_pki_file() {
  local name=$1 source=$ROTATION_BACKUP/pki-files/$name target=$PKI_DIR/pki/$name
  if [[ -e "$source" || -L "$source" ]]; then
    publish_copy_atomically "$source" "$target"
  elif [[ -e "$target" || -L "$target" ]]; then
    rm -f -- "$target"
  fi
}

restore_pki_directory() {
  local name=$1
  local source=$ROTATION_BACKUP/pki-dirs/$name
  local marker=$ROTATION_BACKUP/pki-dir-markers/$name
  local target=$PKI_DIR/pki/$name
  local current rel

  if [[ -e "$marker" ]]; then
    [[ -d "$target" && ! -L "$target" ]] || return 1
    while IFS= read -r -d '' current; do
      rel=${current#"$target"/}
      if [[ ! -e "$source/$rel" && ! -L "$source/$rel" ]]; then
        rm -f -- "$current" || return 1
      fi
    done < <(find "$target" -mindepth 1 ! -type d -print0)
    while IFS= read -r -d '' current; do
      rel=${current#"$target"/}
      if [[ ! -d "$source/$rel" ]]; then
        rmdir "$current" 2>/dev/null || true
      fi
    done < <(find "$target" -depth -mindepth 1 -type d -print0)
    cp -pR "$source/." "$target/"
  elif [[ -e "$target" || -L "$target" ]]; then
    [[ -d "$target" && ! -L "$target" ]] || return 1
    find "$target" -mindepth 1 ! -type d -exec rm -f -- {} + || return 1
    find "$target" -depth -mindepth 1 -type d -exec rmdir {} + 2>/dev/null || true
    rmdir "$target"
  fi
}

restore_rotation_state() {
  local name restore_failed=0
  for name in \
    index.txt index.txt.attr index.txt.attr.old index.txt.old \
    serial serial.old crlnumber crlnumber.old crl.pem; do
    restore_pki_file "$name" || restore_failed=1
  done
  for name in issued private reqs certs_by_serial revoked renewed inline; do
    restore_pki_directory "$name" || restore_failed=1
  done
  publish_file_atomically "$ROTATION_BACKUP/profile.ovpn" "$PROFILE_PATH" 0600 || restore_failed=1
  publish_file_atomically "$ROTATION_BACKUP/active-client-cn" "$ACTIVE_CLIENT_CN_FILE" 0600 || restore_failed=1
  publish_file_atomically "$ROTATION_BACKUP/server-crl.pem" "$SERVER_CRL_PATH" 0644 || restore_failed=1
  return "$restore_failed"
}

rollback_rotation() {
  local status=$?
  local restore_failed=0
  trap - ERR
  printf 'error: rotation failed; restoring previous profile state\n' >&2
  restore_rotation_state || restore_failed=1
  if (( ROTATION_RELOAD_ON_ROLLBACK )); then
    systemctl reload openvpn-server@course || true
  fi
  if (( restore_failed )); then
    printf 'warning: rollback encountered one or more restore failures\n' >&2
  fi
  return "$status"
}

publish_export() {
  local profile_path=$1 destination_directory=$2 destination_name=$3 force=$4 owner_uid=$5 owner_gid=$6
  python3 - "$profile_path" "$destination_directory" "$destination_name" "$force" "$owner_uid" "$owner_gid" <<'PY'
import errno
import os
import secrets
import stat
import sys

profile_path, directory, destination_name, force, owner_uid, owner_gid = sys.argv[1:]


class ExportError(Exception):
    pass


def close_fd(fd):
    if fd >= 0:
        os.close(fd)


def sync_directory(directory_fd):
    try:
        os.fsync(directory_fd)
    except OSError as error:
        if error.errno not in (errno.EINVAL, errno.EROFS):
            raise


def copy_file(source_fd, staging_fd):
    while True:
        chunk = os.read(source_fd, 1024 * 1024)
        if not chunk:
            return
        view = memoryview(chunk)
        while view:
            written = os.write(staging_fd, view)
            view = view[written:]


def create_staging_file(directory_fd):
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    for _ in range(32):
        name = ".openvpn-course." + secrets.token_hex(16)
        try:
            return name, os.open(name, flags, 0o600, dir_fd=directory_fd)
        except FileExistsError:
            continue
    raise ExportError("could not create export temporary file")


def open_directory_component(parent_fd, component, directory_flags):
    try:
        component_stat = os.stat(component, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError as error:
        raise ExportError("destination directory does not exist") from error
    if stat.S_ISLNK(component_stat.st_mode):
        raise ExportError("destination directory must not contain symlinks")
    if not stat.S_ISDIR(component_stat.st_mode):
        raise ExportError("destination directory component is not a directory")
    return os.open(component, directory_flags, dir_fd=parent_fd)


def open_destination_directory(directory):
    directory_flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    if os.path.isabs(directory):
        directory_fd = os.open(os.sep, directory_flags)
    else:
        directory_fd = os.open(".", directory_flags)

    try:
        for component in directory.split(os.sep):
            if component in ("", "."):
                continue
            if component == "..":
                raise ExportError("destination directory must not contain '..'")
            next_fd = open_directory_component(directory_fd, component, directory_flags)
            close_fd(directory_fd)
            directory_fd = next_fd
    except Exception:
        close_fd(directory_fd)
        raise
    return directory_fd


def publish(directory_fd, staging_name, destination_name, force):
    try:
        destination_stat = os.stat(destination_name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        destination_stat = None

    if destination_stat is None:
        try:
            os.link(
                staging_name,
                destination_name,
                src_dir_fd=directory_fd,
                dst_dir_fd=directory_fd,
                follow_symlinks=False,
            )
        except FileExistsError as error:
            raise ExportError("destination already exists") from error
        os.unlink(staging_name, dir_fd=directory_fd)
        return

    if force != "--force":
        raise ExportError("destination already exists")
    if not stat.S_ISREG(destination_stat.st_mode):
        raise ExportError("destination must be a regular file")
    os.replace(
        staging_name,
        destination_name,
        src_dir_fd=directory_fd,
        dst_dir_fd=directory_fd,
    )


def main():
    source_fd = directory_fd = staging_fd = -1
    staging_name = None
    staging_identity = None
    try:
        source_fd = os.open(profile_path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        if not stat.S_ISREG(os.fstat(source_fd).st_mode):
            raise ExportError("profile must be a regular file")

        if destination_name in (".", ".."):
            raise ExportError("destination must name a regular file")
        directory_fd = open_destination_directory(directory)
        staging_name, staging_fd = create_staging_file(directory_fd)
        staging_stat = os.fstat(staging_fd)
        if not stat.S_ISREG(staging_stat.st_mode):
            raise ExportError("temporary export is not a regular file")
        staging_identity = (staging_stat.st_dev, staging_stat.st_ino)

        copy_file(source_fd, staging_fd)
        os.fchmod(staging_fd, 0o600)
        if owner_uid and owner_gid:
            os.fchown(staging_fd, int(owner_uid), int(owner_gid))
        os.fsync(staging_fd)
        publish(directory_fd, staging_name, destination_name, force)
        staging_name = None
        sync_directory(directory_fd)
    except (ExportError, OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        if directory_fd >= 0 and staging_name is not None and staging_identity is not None:
            try:
                current = os.stat(staging_name, dir_fd=directory_fd, follow_symlinks=False)
                if stat.S_ISREG(current.st_mode) and (current.st_dev, current.st_ino) == staging_identity:
                    os.unlink(staging_name, dir_fd=directory_fd)
            except OSError:
                pass
        close_fd(staging_fd)
        close_fd(source_fd)
        close_fd(directory_fd)
    return 0


raise SystemExit(main())
PY
}

export_command() {
  local destination force= destination_directory destination_name owner_uid= owner_gid=

  [[ $# -ge 1 && $# -le 2 ]] || die "usage: openvpn-course export DEST [--force]"
  destination=$1
  [[ -n "$destination" ]] || die "usage: openvpn-course export DEST [--force]"
  [[ "$destination" != --force ]] || die "usage: openvpn-course export DEST [--force]"
  if [[ $# -eq 2 ]]; then
    force=$2
    [[ "$force" == --force ]] || die "usage: openvpn-course export DEST [--force]"
  fi

  case "$destination" in
    */*)
      destination_directory=${destination%/*}
      [[ -n "$destination_directory" ]] || destination_directory=/
      destination_name=${destination##*/}
      ;;
    *)
      destination_directory=.
      destination_name=$destination
      ;;
  esac
  [[ -n "$destination_name" ]] || die "destination must name a regular file: $destination"
  if [[ ${SUDO_UID:-} =~ ^[0-9]+$ && ${SUDO_GID:-} =~ ^[0-9]+$ ]]; then
    owner_uid=$SUDO_UID
    owner_gid=$SUDO_GID
  fi
  publish_export "$PROFILE_PATH" "$destination_directory" "$destination_name" "$force" "$owner_uid" "$owner_gid" || die "could not publish export: $destination"
  printf 'Exported %s\n' "$destination"
}

logs_command() {
  journalctl -u openvpn-server@course --no-pager -n 100
}

rotate_command() {
  local days confirmation old_cn new_cn

  [[ $# -eq 2 && ${1:-} == --days && ${2:-} =~ ^[0-9]+$ ]] || die "usage: openvpn-course rotate --days N"
  days=$2
  (( 10#$days >= 1 && 10#$days <= 365 )) || die "usage: openvpn-course rotate --days N"

  printf 'Type ROTATE course-shared to invalidate every distributed profile: '
  IFS= read -r confirmation || die "rotation cancelled"
  [[ "$confirmation" == "ROTATE course-shared" ]] || die "rotation cancelled"
  acquire_mutation_lock

  [[ -x "$PKI_DIR/easyrsa" ]] || die "missing Easy-RSA executable: $PKI_DIR/easyrsa"
  [[ -x "$PKI_DIR/render-profile" ]] || die "missing profile renderer: $PKI_DIR/render-profile"
  [[ -f "$PKI_DIR/pki/ca.crt" ]] || die "missing CA certificate: $PKI_DIR/pki/ca.crt"
  [[ -f "$PKI_DIR/pki/crl.pem" ]] || die "missing PKI CRL: $PKI_DIR/pki/crl.pem"
  [[ -f "$SERVER_CRL_PATH" ]] || die "missing installed CRL: $SERVER_CRL_PATH"
  [[ -s "$ACTIVE_CLIENT_CN_FILE" ]] || die "missing active client CN"

  old_cn=$(<"$ACTIVE_CLIENT_CN_FILE")
  [[ -n "$old_cn" ]] || die "missing active client CN"
  new_cn="course-shared-$(date -u +%Y%m%d%H%M%S)"
  ROTATION_WORK=$(mktemp -d "$PKI_DIR/rotate.XXXXXX")
  trap cleanup_rotation EXIT
  ROTATION_BACKUP=$(mktemp -d "$PKI_DIR/rollback.XXXXXX")
  backup_rotation_state
  trap rollback_rotation ERR

  (cd "$PKI_DIR" && EASYRSA_BATCH=1 EASYRSA_CERT_EXPIRE="$days" ./easyrsa build-client-full "$new_cn" nopass)
  openssl verify -CAfile "$PKI_DIR/pki/ca.crt" "$PKI_DIR/pki/issued/$new_cn.crt"
  # Keep the connection settings scoped to the renderer process. The sourced
  # environment file intentionally does not globally export them.
  PKI_DIR="$PKI_DIR" \
    ENDPOINT="$ENDPOINT" \
    OPENVPN_PORT="${OPENVPN_PORT:-1194}" \
    OPENVPN_PROTOCOL="${OPENVPN_PROTOCOL:-udp}" \
    "$PKI_DIR/render-profile" "$new_cn" >"$ROTATION_WORK/current.ovpn"
  validate_rendered_profile "$ROTATION_WORK/current.ovpn"

  ROTATION_RELOAD_ON_ROLLBACK=1
  (cd "$PKI_DIR" && EASYRSA_BATCH=1 ./easyrsa revoke "$old_cn" && EASYRSA_BATCH=1 ./easyrsa gen-crl)
  publish_file_atomically "$ROTATION_WORK/current.ovpn" "$PROFILE_PATH" 0600
  publish_text_atomically "$new_cn" "$ACTIVE_CLIENT_CN_FILE" 0600
  publish_file_atomically "$PKI_DIR/pki/crl.pem" "$SERVER_CRL_PATH" 0644
  systemctl reload openvpn-server@course
  trap - ERR
  trap - EXIT
  cleanup_rotation
  ROTATION_RELOAD_ON_ROLLBACK=0
  printf 'Rotated course shared profile to %s\n' "$new_cn"
}

share_command() {
  local suffix key previous_key uri url expires_at

  [[ $# -eq 0 ]] || die "usage: openvpn-course share"
  suffix=$(openssl rand -hex 16)
  [[ "$suffix" =~ ^[0-9a-f]{32}$ ]] || die "could not generate profile share key"
  key="profiles/$suffix/course-vpn.ovpn"
  uri="s3://$PROFILE_BUCKET/$key"

  if [[ -s "$LAST_SHARED_KEY_FILE" ]]; then
    previous_key=$(<"$LAST_SHARED_KEY_FILE")
    if [[ "$previous_key" =~ ^profiles/[0-9a-f]{32}/course-vpn\.ovpn$ ]]; then
      aws s3 rm "s3://$PROFILE_BUCKET/$previous_key" \
        --only-show-errors --region "$AWS_REGION" || \
        printf 'warning: previous object cleanup failed; S3 lifecycle remains active\n' >&2
    else
      printf 'warning: recorded previous profile key has unexpected format; skipping cleanup\n' >&2
    fi
  fi

  aws s3 cp "$PROFILE_PATH" "$uri" --only-show-errors --region "$AWS_REGION"
  url=$(aws s3 presign "$uri" --expires-in 600 --region "$AWS_REGION")
  # Signing completed before the clock is read, so this is a conservative
  # upper bound even when AWS chose a signature timestamp just before return.
  expires_at=$(utc_after_seconds 600) || die "could not calculate presign deadline"
  publish_text_atomically "$key" "$LAST_SHARED_KEY_FILE" 0600
  printf '%s\nExpires no later than: %s\n' "$url" "$expires_at"
}

load_environment
case ${1:-} in
  status)
    [[ $# -eq 1 ]] || die "usage: openvpn-course status"
    status_command
    ;;
  export)
    shift
    export_command "$@"
    ;;
  rotate)
    shift
    [[ $# -eq 2 && ${1:-} == --days && ${2:-} =~ ^[0-9]+$ ]] || die "usage: openvpn-course rotate --days N"
    (( 10#${2:-0} >= 1 && 10#${2:-0} <= 365 )) || die "usage: openvpn-course rotate --days N"
    rotate_command "$@"
    ;;
  share)
    shift
    [[ $# -eq 0 ]] || die "usage: openvpn-course share"
    acquire_mutation_lock
    share_command "$@"
    ;;
  logs)
    [[ $# -eq 1 ]] || die "usage: openvpn-course logs"
    logs_command
    ;;
  *) die "usage: openvpn-course {status|export|rotate|share|logs}" ;;
esac
