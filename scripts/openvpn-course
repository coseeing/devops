#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly PRODUCTION_ENV_FILE=/etc/openvpn/openvpn-course.env
ENV_FILE=${OPENVPN_COURSE_ENV_FILE:-$PRODUCTION_ENV_FILE}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

load_environment() {
  [[ -f "$ENV_FILE" ]] || die "configuration not found: $ENV_FILE"
  if [[ "$ENV_FILE" == "$PRODUCTION_ENV_FILE" ]]; then
    [[ $EUID -eq 0 ]] || die "run with sudo"
    [[ $(stat -c '%u' "$ENV_FILE") == 0 ]] || die "configuration must be root-owned"
    local mode
    mode=$(stat -c '%a' "$ENV_FILE")
    (( (8#$mode & 8#077) == 0 )) || die "configuration must not be accessible by group or other"
  fi

  # The Ansible template shell-quotes every value and defines only the allowlisted names.
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  local name
  for name in PROFILE_PATH PKI_DIR ACTIVE_CLIENT_CN_FILE STATUS_PATH ENDPOINT VPN_CIDR WINDOWS_CIDR PROFILE_BUCKET AWS_REGION; do
    [[ -n ${!name:-} ]] || die "missing configuration: $name"
  done
}

status_command() {
  local clients=0 service_state listener expiry active_cn
  active_cn=$(<"$ACTIVE_CLIENT_CN_FILE")
  service_state=$(systemctl is-active openvpn-server@course 2>/dev/null || true)
  listener=$(ss -lun 2>/dev/null | grep -Ec '[:.]1194[[:space:]]' || true)
  [[ -f "$STATUS_PATH" ]] && clients=$(grep -c '^CLIENT_LIST,' "$STATUS_PATH" || true)
  expiry=$(openssl x509 -in "$PKI_DIR/pki/issued/$active_cn.crt" -enddate -noout 2>/dev/null || true)
  printf 'Service: %s\nUDP 1194 listeners: %s\nEndpoint: %s\nVPN CIDR: %s\nWindows CIDR: %s\nConnected clients: %s\nCertificate: %s\n' \
    "${service_state:-unknown}" "$listener" "$ENDPOINT" "$VPN_CIDR" "$WINDOWS_CIDR" "$clients" "${expiry:-unknown}"
}

file_identity() {
  if stat -c '%d:%i' "$1" >/dev/null 2>&1; then
    stat -c '%d:%i' "$1"
  else
    stat -f '%d:%i' "$1"
  fi
}

publish_export() {
  local destination_directory=$1 destination_name=$2 temporary_name=$3 force=$4
  python3 - "$destination_directory" "$destination_name" "$temporary_name" "$force" <<'PY'
import os
import stat
import sys

directory, destination_name, temporary_name, force = sys.argv[1:]
directory_flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
directory_fd = os.open(directory, directory_flags)
try:
    temporary_stat = os.stat(temporary_name, dir_fd=directory_fd, follow_symlinks=False)
    if not stat.S_ISREG(temporary_stat.st_mode):
        raise RuntimeError("temporary export is not a regular file")

    try:
        destination_stat = os.stat(destination_name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        destination_stat = None

    if destination_stat is None:
        os.link(
            temporary_name,
            destination_name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
            follow_symlinks=False,
        )
        os.unlink(temporary_name, dir_fd=directory_fd)
    else:
        if force != "--force":
            raise RuntimeError("destination already exists")
        if not stat.S_ISREG(destination_stat.st_mode):
            raise RuntimeError("destination must be a regular file")
        os.replace(
            temporary_name,
            destination_name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
finally:
    os.close(directory_fd)
PY
}

export_command() {
  local destination force= destination_directory destination_name
  local temporary= temporary_identity=
  cleanup_export_temp() {
    local current_identity
    [[ -n "$temporary" && -n "$temporary_identity" ]] || return
    [[ ! -L "$temporary" && -f "$temporary" ]] || return
    current_identity=$(file_identity "$temporary" 2>/dev/null || true)
    [[ "$current_identity" == "$temporary_identity" ]] || return
    rm -f -- "$temporary"
  }

  [[ $# -ge 1 && $# -le 2 ]] || die "usage: openvpn-course export DEST [--force]"
  destination=$1
  [[ -n "$destination" ]] || die "usage: openvpn-course export DEST [--force]"
  [[ "$destination" != --force ]] || die "usage: openvpn-course export DEST [--force]"
  if [[ $# -eq 2 ]]; then
    force=$2
    [[ "$force" == --force ]] || die "usage: openvpn-course export DEST [--force]"
  fi

  case "$destination" in
    */*)
      destination_directory=${destination%/*}
      [[ -n "$destination_directory" ]] || destination_directory=/
      destination_name=${destination##*/}
      ;;
    *)
      destination_directory=.
      destination_name=$destination
      ;;
  esac
  [[ -n "$destination_name" ]] || die "destination must name a regular file: $destination"
  [[ -d "$destination_directory" && ! -L "$destination_directory" ]] || die "destination directory is not available: $destination_directory"
  [[ ! -L "$destination" ]] || die "destination must be a regular file: $destination"
  [[ ! -e "$destination" || -f "$destination" ]] || die "destination must be a regular file: $destination"
  [[ ! -e "$destination" || "$force" == --force ]] || die "destination already exists: $destination"

  temporary=$(mktemp -p "$destination_directory" '.openvpn-course.XXXXXX') || die "could not create export temporary file"
  temporary_identity=$(file_identity "$temporary") || die "could not validate export temporary file"
  [[ ! -L "$temporary" && -f "$temporary" ]] || die "export temporary file is not a regular file"
  trap cleanup_export_temp EXIT
  install -m 0600 -- "$PROFILE_PATH" "$temporary"
  temporary_identity=$(file_identity "$temporary") || die "could not validate export temporary file"
  [[ ! -L "$temporary" && -f "$temporary" ]] || die "export temporary file is not a regular file"
  if [[ ${SUDO_UID:-} =~ ^[0-9]+$ && ${SUDO_GID:-} =~ ^[0-9]+$ ]]; then
    chown "$SUDO_UID:$SUDO_GID" -- "$temporary"
  fi
  publish_export "$destination_directory" "$destination_name" "${temporary##*/}" "$force" || die "could not publish export: $destination"
  temporary=
  temporary_identity=
  trap - EXIT
  printf 'Exported %s\n' "$destination"
}

logs_command() {
  journalctl -u openvpn-server@course --no-pager -n 100
}

load_environment
case ${1:-} in
  status)
    [[ $# -eq 1 ]] || die "usage: openvpn-course status"
    status_command
    ;;
  export)
    shift
    export_command "$@"
    ;;
  logs)
    [[ $# -eq 1 ]] || die "usage: openvpn-course logs"
    logs_command
    ;;
  *) die "usage: openvpn-course {status|export|logs}" ;;
esac
